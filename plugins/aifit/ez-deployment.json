{
  "schemaVersion": 1,
  "services": {
    "aifit": {
      "buildTarget": "runtime",
      "healthcheck": ["node", "--version"],
      "command": ["tail", "-f", "/dev/null"]
    }
  },
  "commands": {
    "aifit": {
      "service": "aifit",
      "argv": ["node", "/app/bin/aifit.mjs"],
      "suffix": []
    }
  },
  "exports": {}
}
