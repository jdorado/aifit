MONGO_URL=mongodb://localhost:27017
MONGO_DB=aifit_dev
# Use a Privy application owned by your deployment.
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
EZ_BINDINGS_FILE=/path/outside/repository/ez-bindings.json
# Optional: use the existing Telegram deployment while web chat runs locally.
# Same private registry format and owner verification; defaults to EZ_BINDINGS_FILE.
EZ_TELEGRAM_BINDINGS_FILE=
# Optional deployment-owned authorization policy. Keep the referenced file
# outside the source tree and use immutable Privy subjects.
AIFIT_MODEL_POLICY_FILE=
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://[::1]:5175
# Optional regex for browser origins outside CORS_ORIGINS; use a private
# LAN/VPN range so any local app origin is accepted without per-port edits.
# Starlette matches the whole origin against this regex.
# CORS_ORIGIN_REGEX=https?://(?:localhost|127\.0\.0\.1|\[::1\]|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(?:1[6-9]|2\d|3[01])\.\d+\.\d+|[A-Za-z0-9-]+\.local)(?::\d+)?
# Required when the AIFit Ez plugin is installed. The URL must be reachable
# from the plugin command environment; never expose it to browser code.
AIFIT_AGENT_API_BASE_URL=
AIFIT_AGENT_CAPABILITY_SECRET=
