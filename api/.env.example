MONGO_URL=mongodb://localhost:27017
MONGO_DB=aifit_dev
# Reuse the existing AIFit Privy client app; do not create a second one.
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
EZ_BINDINGS_FILE=/absolute/private/aifit-dev/ez-bindings.json
# Optional deployment-owned authorization policy. Leave unset in public installs.
# The referenced file stays outside the source tree and uses immutable Privy subjects.
AIFIT_MODEL_POLICY_FILE=
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://[::1]:5175
# Leave unset so local QA signs in through Privy. Never deploy this mode.
AIFIT_DEV_AUTH_TOKEN=
AIFIT_DEV_SUBJECT=dev:aifit-local
# Required when the AIFit Ez plugin is installed. This URL must be reachable
# from the plugin command container; do not expose it to browser code.
AIFIT_AGENT_API_BASE_URL=
AIFIT_AGENT_CAPABILITY_SECRET=
